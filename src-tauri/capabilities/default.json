{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://dev.azure.com/*" },
        { "url": "https://*.dev.azure.com/*" },
        { "url": "https://app.vssps.visualstudio.com/*" }
      ]
    }
  ]
}
